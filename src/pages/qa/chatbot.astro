---
import '@/styles/globals.css';
import ChatWidgetFixture from '@/components/chat/ChatWidgetFixture';
export const prerender = false;
// Both gates are required: this fixture cannot open in a production build.
if (!import.meta.env.DEV || import.meta.env.PUBLIC_CHAT_UI_QA !== 'true') return new Response('Not found', { status: 404 });
const simulateFiles = Astro.url.searchParams.get('files') === 'simulated';
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Recette locale · Assistant Jamm Immo</title></head>
<body style="margin:0;background:#faf7f1;color:#252738;font-family:'Plus Jakarta Sans',sans-serif">
  <main style="min-height:140vh;padding:36px 24px;max-width:900px;margin:auto">
    <p style="font-size:12px;color:#716b7c">RECETTE LOCALE · DONNÉES FICTIVES · AUCUN ENVOI</p>
    {simulateFiles && <p style="font-size:14px;font-weight:700;color:#794418">PIÈCES JOINTES SIMULÉES · AUCUN SCAN ANTIVIRUS · AUCUN FICHIER TRANSMIS</p>}
    <h1 style="font-family:Fraunces,serif;font-size:42px;line-height:1.15;margin:36px 0 18px">Un projet immobilier,<br />un premier échange.</h1>
    <p style="max-width:45ch">Ce cadre permet d’évaluer le vrai composant de conversation, son ergonomie et son accessibilité, sans contacter les services de production.</p>
    <button data-copy-ref data-ref="QA-LOCAL" style="min-height:44px;border:1px solid #ddd5c7;border-radius:12px;padding:10px 16px;margin-top:22px">Contexte fictif · QA-LOCAL</button>
    <p style="margin-top:70px">Le panneau doit rester lisible au clavier, en portrait et en paysage.</p>
    <a href="#bas" style="display:inline-block;padding:14px 0">Repère clavier derrière le panneau</a>
    <div id="bas" style="margin-top:350px">Bas de page de recette</div>
  </main>
  <aside data-chat-obstruction style="position:fixed;inset:auto 0 0;padding:16px 24px;background:#fffdfa;border-top:1px solid #ddd5c7;font-size:13px;min-height:64px;z-index:40">Barre fixe de fiche · le lanceur reste au-dessus</aside>
  <ChatWidgetFixture simulateFiles={simulateFiles} client:only="react" />
</body></html>
