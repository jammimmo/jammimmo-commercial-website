{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@catalogue-public": ["src/data/public-catalogue-20261031.json"],
      "@catalogue-facts": ["src/data/public-property-facts-20261031.json"],
      "@catalogue-approval": ["src/data/public-catalogue-approval.json"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules", ".astro"]
}
